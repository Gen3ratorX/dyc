# Server-side variables only. Never prefix DATABASE_URL with NEXT_PUBLIC_.
# Copy the Transaction pooler URL from Supabase > Connect.
DATABASE_URL=postgresql://USER.PROJECT:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
BOOTSTRAP_ADMIN_EMAIL=admin@dyccamp.com
# Set this to the final Vercel production origin, without a trailing slash.
APP_ORIGIN=https://YOUR_APP.vercel.app
